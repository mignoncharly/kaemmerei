{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "message": {"format": "%(message)s"}
  },
  "handlers": {
    "requests": {
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "logs/requests.jsonl",
      "maxBytes": 10485760,
      "backupCount": 7,
      "encoding": "utf-8",
      "formatter": "message"
    },
    "errors": {
      "class": "logging.StreamHandler",
      "formatter": "message",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "ohvr.requests": {"handlers": ["requests"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["errors"], "level": "WARNING", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "CRITICAL", "propagate": false}
  }
}
