# Copy to .env if desired, load values through your secure process manager.
# Do not commit an actual .env file.
APP_ENV=development
DATABASE_URL=sqlite:///./data/vertragsregister.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# APP_ENV=production needs PostgreSQL, explicit ALLOWED_HOSTS, TLS reverse proxy
# DATABASE_URL=postgresql+psycopg://... (never commit credentials)
# Production: distinct restricted web and read integration roles, no schema ownership.
# INTEGRATION_DATABASE_URL=postgresql+psycopg://...
# ENFORCE_DATABASE_SECURITY=1
# Operator process only; do not inject these privileged URLs into web workers:
# MIGRATION_DATABASE_URL=postgresql+psycopg://...
# MAINTENANCE_DATABASE_URL=postgresql+psycopg://...
# Pilot default; municipal D04 approval still required before business deployment:
# MANDATORY_REVIEW_RECIPIENTS=Kämmerei
# Private absolute path, outside static/public/template roots. Production ACLs required.
# DOCUMENT_STORAGE_DIR=C:\private\ohvr-documents
# Supported maintained ClamAV installation and official FreshClam-managed database:
# CLAMAV_EXECUTABLE=C:\Program Files\ClamAV\clamscan.exe
# CLAMAV_DATABASE_DIR=C:\private\clamav-db
# SCANNER_TIMEOUT=60
# SCANNER_MAX_AGE_HOURS=72
# Exact approved DMS hosts (empty permits any otherwise valid host); no URL fetching:
# DMS_ALLOWED_HOSTS=dms.example.org
# Phase 9 ingress limits; total multipart 32 MiB, each document 25 MiB.
# Non-multipart bodies additionally have a fixed 1 MiB ceiling.
# REQUEST_MAX_BYTES=33554432
# REQUEST_TIMEOUT_SECONDS=30
# REQUEST_CONCURRENCY=16
# UPLOAD_CONCURRENCY=4
# FORM_MAX_FIELDS=40
# FORM_MAX_FILES=5
# FORM_FIELD_BYTES=65536
# DOCUMENT_STORAGE_QUOTA_BYTES=10737418240
# DOCUMENT_STORAGE_RESERVE_BYTES=268435456
# DATABASE_POOL_SIZE=8
# DATABASE_POOL_TIMEOUT=5
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Only actual proxy addresses; leave empty for direct development.
# Run Uvicorn with --no-proxy-headers: application validates these itself.
# TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
# Production web/integration/operator PostgreSQL URLs require sslmode=verify-full
# and sslrootcert=<absolute operator-provisioned CA file>; use secure injection.
# Production uploads always persist quarantine jobs without inline scans.
# Enable the same workflow in development to exercise the native coordinator:
# DEFER_DOCUMENT_SCANS=1
# Operator process (explicit MIGRATION_DATABASE_URL), scheduled separately:
# python -m app.cli scan-pending --limit 10 --seconds 120
# Five persisted attempts, 1/2/4/8 minute retry delays; failures never publish.
