# Copy to .env if desired, load values through your secure process manager.
# Do not commit an actual .env file.
APP_ENV=development
DATABASE_URL=sqlite:///./data/vertragsregister.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# APP_ENV=production needs PostgreSQL, explicit ALLOWED_HOSTS, TLS reverse proxy
# DATABASE_URL=postgresql+psycopg://... (never commit credentials)
# Production: distinct restricted web and read integration roles, no schema ownership.
# INTEGRATION_DATABASE_URL=postgresql+psycopg://...
# ENFORCE_DATABASE_SECURITY=1
# Operator process only; do not inject these privileged URLs into web workers:
# MIGRATION_DATABASE_URL=postgresql+psycopg://...
# MAINTENANCE_DATABASE_URL=postgresql+psycopg://...
