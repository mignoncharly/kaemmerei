# Copy to .env if desired, load values through your secure process manager.
# Do not commit an actual .env file.
APP_ENV=development
DATABASE_URL=sqlite:///./data/vertragsregister.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
# APP_ENV=production needs PostgreSQL, explicit ALLOWED_HOSTS, TLS reverse proxy
# DATABASE_URL=postgresql+psycopg://... (never commit credentials)
# Production: distinct restricted web and read integration roles, no schema ownership.
# INTEGRATION_DATABASE_URL=postgresql+psycopg://...
# ENFORCE_DATABASE_SECURITY=1
# Operator process only; do not inject these privileged URLs into web workers:
# MIGRATION_DATABASE_URL=postgresql+psycopg://...
# MAINTENANCE_DATABASE_URL=postgresql+psycopg://...
# Pilot default; municipal D04 approval still required before business deployment:
# MANDATORY_REVIEW_RECIPIENTS=Kämmerei
# Private absolute path, outside static/public/template roots. Production ACLs required.
# DOCUMENT_STORAGE_DIR=C:\private\ohvr-documents
# Supported maintained ClamAV installation and official FreshClam-managed database:
# CLAMAV_EXECUTABLE=C:\Program Files\ClamAV\clamscan.exe
# CLAMAV_DATABASE_DIR=C:\private\clamav-db
# SCANNER_TIMEOUT=60
# SCANNER_MAX_AGE_HOURS=72
# Exact approved DMS hosts (empty permits any otherwise valid host); no URL fetching:
# DMS_ALLOWED_HOSTS=dms.example.org
